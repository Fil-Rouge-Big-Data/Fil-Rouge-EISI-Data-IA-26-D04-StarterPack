  observation [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label=<<B>observe</B><BR/>valeur<BR/>date_calcul>];
  objectif [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label=<<B>vise</B><BR/>valeur_cible<BR/>date_fixation>];
  a8 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="donne lieu à"];
  a9 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est signé par le chasseur"];
  a10 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="renouvelle"];
  a11 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="fige les critères de"];
  a12 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est signé par le client"];
  a13 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="reprend l'état de"];
  a16 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="se concrétise par"];
  a23 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est cadrée par"];
  a36 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#e8710a", label="achat hors dispositif sous"];
  a42 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="au titre du mandat"];
  utilisateur -- observation [taillabel="0,n"];
  indicateur -- observation [taillabel="0,n"];
  periode -- observation [taillabel="0,n"];
