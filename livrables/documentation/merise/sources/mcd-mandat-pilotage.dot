  edge [fontname="Helvetica-Bold", fontsize=10, color="#555555"];
  indicateur [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>INDICATEUR</B></TD></TR><TR><TD ALIGN="LEFT"><U>code_indicateur</U></TD></TR><TR><TD ALIGN="LEFT">libelle</TD></TR><TR><TD ALIGN="LEFT">unite</TD></TR><TR><TD ALIGN="LEFT">perimetre_role</TD></TR><TR><TD ALIGN="LEFT">sens_optimal</TD></TR><TR><TD ALIGN="LEFT">mode_calcul</TD></TR></TABLE>>];
