  visite [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>VISITE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_visite</U></TD></TR><TR><TD ALIGN="LEFT">date_visite</TD></TR><TR><TD ALIGN="LEFT">realisee</TD></TR><TR><TD ALIGN="LEFT">motif_annulation</TD></TR></TABLE>>];
  bien [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>BIEN</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_bien</U></TD></TR><TR><TD ALIGN="LEFT">type_bien</TD></TR><TR><TD ALIGN="LEFT">surface</TD></TR><TR><TD ALIGN="LEFT">nb_pieces</TD></TR><TR><TD ALIGN="LEFT">nb_chambres</TD></TR><TR><TD ALIGN="LEFT">etage</TD></TR><TR><TD ALIGN="LEFT">dpe</TD></TR><TR><TD ALIGN="LEFT">adresse_indicative</TD></TR><TR><TD ALIGN="LEFT">code_postal</TD></TR><TR><TD ALIGN="LEFT">a_ascenseur</TD></TR><TR><TD ALIGN="LEFT">a_balcon</TD></TR><TR><TD ALIGN="LEFT">a_terrasse</TD></TR><TR><TD ALIGN="LEFT">a_jardin</TD></TR><TR><TD ALIGN="LEFT">a_parking</TD></TR><TR><TD ALIGN="LEFT">a_cave</TD></TR></TABLE>>];
