  a8 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="donne lieu à"];
  a11 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="fige les critères de"];
  a17 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est situé dans"];
  a19 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="répond à"];
  a21 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="selon la version"];
  a24 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est rédigé par"];
  a25 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="commente la demande"];
  a26 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="commente la proposition"];
  a27 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="commente le bien"];
  demande -- demande_acquereur [taillabel="0,n"];
  client -- demande_acquereur [taillabel="0,n"];
  demande_version -- version_zone [taillabel="0,n"];
  zone -- version_zone [taillabel="0,n"];
  chasseur -- chasseur_zone [taillabel="0,n"];
  zone -- chasseur_zone [taillabel="0,n"];
  demande -- a1 [taillabel="0,1"];
