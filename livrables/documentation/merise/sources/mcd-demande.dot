// GÉNÉRÉ par generer_mcd.py depuis livrables/db/01_ddl.sql : ne pas modifier à la main.
graph MCD {
  graph [label="MCD v8.42 — domaine « Demande » : entités et attributs complets\nen gris : entités des autres domaines, détaillées dans leur propre schéma", labelloc=t, fontname="Helvetica-Bold", fontsize=16, pad=0.3, splines=true, rankdir=LR, nodesep=0.35, ranksep=1.0];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica-Bold", fontsize=10, color="#555555"];
  demande_version [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>DEMANDE_VERSION</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_version</U></TD></TR><TR><TD ALIGN="LEFT">no_version</TD></TR><TR><TD ALIGN="LEFT">date_creation</TD></TR><TR><TD ALIGN="LEFT">motif_evolution</TD></TR><TR><TD ALIGN="LEFT">type_bien</TD></TR><TR><TD ALIGN="LEFT">destination</TD></TR><TR><TD ALIGN="LEFT">budget_max</TD></TR><TR><TD ALIGN="LEFT">surface_min</TD></TR><TR><TD ALIGN="LEFT">nb_pieces_min</TD></TR><TR><TD ALIGN="LEFT">nb_chambres_min</TD></TR><TR><TD ALIGN="LEFT">nb_occupants</TD></TR><TR><TD ALIGN="LEFT">dpe_max</TD></TR><TR><TD ALIGN="LEFT">rendement_brut_min</TD></TR><TR><TD ALIGN="LEFT">travaux_acceptes</TD></TR><TR><TD ALIGN="LEFT">pref_ascenseur</TD></TR><TR><TD ALIGN="LEFT">pref_balcon</TD></TR><TR><TD ALIGN="LEFT">pref_terrasse</TD></TR><TR><TD ALIGN="LEFT">pref_jardin</TD></TR><TR><TD ALIGN="LEFT">pref_parking</TD></TR><TR><TD ALIGN="LEFT">pref_cave</TD></TR><TR><TD ALIGN="LEFT">commentaire_criteres</TD></TR></TABLE>>];
  affectation [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>AFFECTATION</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_affectation</U></TD></TR><TR><TD ALIGN="LEFT">date_debut</TD></TR><TR><TD ALIGN="LEFT">date_fin</TD></TR><TR><TD ALIGN="LEFT">motif</TD></TR></TABLE>>];
  commentaire [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>COMMENTAIRE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_commentaire</U></TD></TR><TR><TD ALIGN="LEFT">type_contexte</TD></TR><TR><TD ALIGN="LEFT">est_prive</TD></TR><TR><TD ALIGN="LEFT">contenu</TD></TR><TR><TD ALIGN="LEFT">date_creation</TD></TR></TABLE>>];
  zone [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>ZONE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_zone</U></TD></TR><TR><TD ALIGN="LEFT">type_zone</TD></TR><TR><TD ALIGN="LEFT">pays</TD></TR><TR><TD ALIGN="LEFT">code_iso_pays</TD></TR><TR><TD ALIGN="LEFT">devise</TD></TR><TR><TD ALIGN="LEFT">ville</TD></TR><TR><TD ALIGN="LEFT">code_insee</TD></TR><TR><TD ALIGN="LEFT">secteur</TD></TR><TR><TD ALIGN="LEFT">code_postal</TD></TR></TABLE>>];
  demande [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#4a7bd0"><TR><TD BGCOLOR="#dbe6f7"><B>DEMANDE</B></TD></TR><TR><TD ALIGN="LEFT"><U>id_demande</U></TD></TR><TR><TD ALIGN="LEFT">date_depot</TD></TR><TR><TD ALIGN="LEFT">canal</TD></TR><TR><TD ALIGN="LEFT">description_initiale</TD></TR><TR><TD ALIGN="LEFT">date_consentement</TD></TR><TR><TD ALIGN="LEFT">date_affectation</TD></TR><TR><TD ALIGN="LEFT">date_qualification</TD></TR><TR><TD ALIGN="LEFT">id_mandat_courant</TD></TR><TR><TD ALIGN="LEFT">date_sans_suite</TD></TR><TR><TD ALIGN="LEFT">motif_sans_suite</TD></TR><TR><TD ALIGN="LEFT">nb_relances</TD></TR><TR><TD ALIGN="LEFT">statut_financement</TD></TR><TR><TD ALIGN="LEFT">apport_disponible</TD></TR><TR><TD ALIGN="LEFT">montant_pret_envisage</TD></TR><TR><TD ALIGN="LEFT">date_accord_principe</TD></TR><TR><TD ALIGN="LEFT">date_validite_accord</TD></TR></TABLE>>];
  bien [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>BIEN</B></TD></TR></TABLE>>];
  chasseur [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>CHASSEUR</B></TD></TR></TABLE>>];
  client [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>CLIENT</B></TD></TR></TABLE>>];
  gestionnaire [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>GESTIONNAIRE</B></TD></TR></TABLE>>];
  mandat [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>MANDAT</B></TD></TR></TABLE>>];
  proposition [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>PROPOSITION</B></TD></TR></TABLE>>];
  utilisateur [shape=none, margin=0, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#9aa0a6"><TR><TD BGCOLOR="#eeeeee"><B>UTILISATEUR</B></TD></TR></TABLE>>];
  demande_acquereur [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label=<<B>acquiert pour</B><BR/>qualite>];
  version_zone [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label=<<B>cible</B>>];
  chasseur_zone [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label=<<B>intervient sur</B><BR/>role_intervention>];
  a1 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est suivie par"];
  a2 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est affectée à"];
  a3 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="porte sur"];
  a4 [shape=ellipse, style=filled, fillcolor="#fff8e1", color="#c77700", label="est décidée par"];
