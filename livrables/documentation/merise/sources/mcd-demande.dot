  demande_version -- a6 [taillabel="1,1"];
  a6 -- demande [headlabel="0,n"];
  demande_version -- a7 [taillabel="1,1"];
  a7 -- utilisateur [headlabel="0,n"];
  mandat -- a8 [taillabel="1,1"];
  a8 -- demande [headlabel="0,n"];
