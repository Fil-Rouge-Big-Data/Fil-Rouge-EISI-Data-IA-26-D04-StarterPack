# ============================================================
# Variables d'environnement — migration Existant -> OLTP v8
# Copier en .env et ajuster. NE PAS committer .env (voir .gitignore).
# ============================================================

# --- Mot de passe partagé des conteneurs PostgreSQL (docker-compose) ---
# OBLIGATOIRE : à renseigner avec un secret propre, lettres et chiffres uniquement
# (évite les caractères spéciaux interprétés par Compose ou bash).
#   Git Bash / Linux / macOS : openssl rand -hex 16
#   PowerShell               : -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 24 | % {[char]$_})
# Laissé vide, `docker compose up` s'arrête avec un message explicite.
POSTGRES_PASSWORD=

# NB : toujours 127.0.0.1, jamais « localhost » (voir run_migration_docker.sh : sous Windows,
# « localhost » passe d'abord par IPv6 et ralentit chaque connexion de plusieurs dizaines de secondes).

# --- Base SOURCE (système hérité, schéma Fil_Rouge_Depart) ---
SRC_PGHOST=127.0.0.1
SRC_PGPORT=5434
SRC_PGUSER=chasse_migration
SRC_PGDATABASE=chasse_source
# (= POSTGRES_PASSWORD ; utilisé hors scripts docker, qui le déduisent eux-mêmes)
SRC_PGPASSWORD=

# --- Base CIBLE (OLTP v8, schéma public) ---
DST_PGHOST=127.0.0.1
DST_PGPORT=5433
DST_PGUSER=chasse_migration
DST_PGDATABASE=chasse_v8
# (= POSTGRES_PASSWORD ; utilisé hors scripts docker, qui le déduisent eux-mêmes)
DST_PGPASSWORD=

# --- URLs psql pratiques (optionnel) ---
# DST_URL=postgresql://chasse_migration:<mot_de_passe>@127.0.0.1:5433/chasse_v8
# SRC_URL=postgresql://chasse_migration:<mot_de_passe>@127.0.0.1:5434/chasse_source
